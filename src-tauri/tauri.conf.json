{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auton",
  "version": "0.1.0",
  "identifier": "dev.auton.grokbot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auton",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your local AI workspace",
    "longDescription": "A desktop workspace for AI bots, conversations, routines, and approvals."
  }
}
